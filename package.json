{
  "name": "@tubealfred/cli",
  "version": "0.1.0",
  "description": "TubeAlfred command-line tools for YouTube video, transcript, comments, channel, playlist, and search data.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.12.1",
  "bin": {
    "tubealfred": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm build"
  },
  "keywords": [
    "youtube",
    "tubealfred",
    "cli",
    "transcript",
    "comments",
    "search"
  ],
  "homepage": "https://tubealfred.com/docs",
  "bugs": {
    "url": "https://github.com/tubealfred/cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/tubealfred/cli.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.5",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
